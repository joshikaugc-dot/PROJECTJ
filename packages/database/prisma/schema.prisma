// ContextOS data model.
//
// Design rules:
// - Every piece of company data belongs to an Organization (strong tenant separation).
// - Verticals share one schema. Vertical-specific data uses nullable `verticalId`
//   scoping and JSON `settings`/`metadata` columns — never per-vertical tables.
// - Vertical *definitions* live in code (@contextos/verticals); the `Vertical`
//   table is the catalog that enablement rows point at.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// ---------------------------------------------------------------------------
/// Identity & tenancy
/// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions      Session[]
  apiTokens     ApiToken[]
  memberships   OrganizationMember[]
  profile       UserProfile?
  preference    UserPreference?
  verticals     UserVertical[]
  aiActions     AIAction[]
  conversations AIConversation[]
}

/// Browser session for the web app (httpOnly cookie holds the raw token; we store a hash).
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Long-lived bearer tokens for clients (Chrome extension, future desktop apps).
model ApiToken {
  id             String    @id @default(cuid())
  userId         String
  name           String
  /// "ctx_" prefix + first chars, for display only.
  prefix         String
  tokenHash      String    @unique
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members          OrganizationMember[]
  companyProfile   CompanyProfile?
  brandProfile     BrandProfile?
  products         Product[]
  customerSegments CustomerSegment[]
  competitors      Competitor[]
  goals            Goal[]
  documents        KnowledgeDocument[]
  verticals        OrganizationVertical[]
  userVerticals    UserVertical[]
  workflows        Workflow[]
  aiActions        AIAction[]
  conversations    AIConversation[]
  integrations     Integration[]
  activeProfiles   UserProfile[]
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           MemberRole   @default(MEMBER)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

/// The individual: role, seniority, writing style, active vertical.
model UserProfile {
  id                   String        @id @default(cuid())
  userId               String        @unique
  jobTitle             String?
  department           String?
  seniority            String?
  responsibilities     String?
  writingPreferences   String?
  activeOrganizationId String?
  activeVerticalId     String?
  onboardingCompleted  Boolean       @default(false)
  updatedAt            DateTime      @updatedAt
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganization   Organization? @relation(fields: [activeOrganizationId], references: [id], onDelete: SetNull)
}

model UserPreference {
  id                 String   @id @default(cuid())
  userId             String   @unique
  /// "auto" | "anthropic" | "openai" | "gemini"
  preferredProvider  String   @default("auto")
  /// When false, AI actions are not stored at all.
  historyEnabled     Boolean  @default(true)
  /// Opt-in: allow surrounding page text for every action that can use it.
  includePageContext Boolean  @default(false)
  settings           Json     @default("{}")
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// ---------------------------------------------------------------------------
/// Verticals
/// ---------------------------------------------------------------------------

enum VerticalStatus {
  AVAILABLE
  COMING_SOON
  DEPRECATED
}

/// Catalog row mirroring a code-defined VerticalDefinition (synced on seed/startup).
model Vertical {
  id          String         @id
  name        String
  description String
  version     String
  status      VerticalStatus @default(COMING_SOON)
  /// Where the definition comes from: "builtin" today, a package id for a future marketplace.
  source      String         @default("builtin")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  organizations OrganizationVertical[]
  users         UserVertical[]
  workflows     Workflow[]
}

/// A vertical installed for an organization, with vertical-specific settings.
model OrganizationVertical {
  id             String       @id @default(cuid())
  organizationId String
  verticalId     String
  enabled        Boolean      @default(true)
  /// Vertical-specific configuration (e.g. marketing channels, sales methodology).
  settings       Json         @default("{}")
  enabledAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vertical       Vertical     @relation(fields: [verticalId], references: [id])

  @@unique([organizationId, verticalId])
}

/// Per-user enablement within an organization (a founder may use Marketing + Sales).
model UserVertical {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  verticalId     String
  enabled        Boolean      @default(true)
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vertical       Vertical     @relation(fields: [verticalId], references: [id])

  @@unique([userId, organizationId, verticalId])
}

/// ---------------------------------------------------------------------------
/// Company Brain (shared across verticals)
/// ---------------------------------------------------------------------------

model CompanyProfile {
  id             String       @id @default(cuid())
  organizationId String       @unique
  industry       String?
  website        String?
  description    String?
  metadata       Json         @default("{}")
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Product {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  description    String?
  features       String[]
  pricing        String?
  url            String?
  isPrimary      Boolean      @default(false)
  metadata       Json         @default("{}")
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model CustomerSegment {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  description    String?
  painPoints     String[]
  isPrimary      Boolean      @default(false)
  metadata       Json         @default("{}")
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Competitor {
  id              String       @id @default(cuid())
  organizationId  String
  name            String
  website         String?
  positioning     String?
  differentiators String?
  metadata        Json         @default("{}")
  createdAt       DateTime     @default(now())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model BrandProfile {
  id               String       @id @default(cuid())
  organizationId   String       @unique
  voiceAttributes  String[]
  voiceDescription String?
  positioning      String?
  tagline          String?
  doList           String[]
  dontList         String[]
  metadata         Json         @default("{}")
  updatedAt        DateTime     @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/// Goals may be company-wide (verticalId null) or vertical-scoped ("marketing").
model Goal {
  id             String       @id @default(cuid())
  organizationId String
  verticalId     String?
  title          String
  description    String?
  metric         String?
  timeframe      String?
  status         String       @default("active")
  metadata       Json         @default("{}")
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, verticalId])
}

enum KnowledgeKind {
  DOCUMENT
  CAMPAIGN
  CONTENT_EXAMPLE
  GUIDELINE
  NOTE
}

/// Documents, campaigns, previous content. Future: chunk + embedding tables
/// (pgvector) hang off this model without changing callers of the context engine.
model KnowledgeDocument {
  id             String        @id @default(cuid())
  organizationId String
  verticalId     String?
  kind           KnowledgeKind @default(DOCUMENT)
  title          String
  content        String
  tags           String[]
  source         String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, kind])
}

/// ---------------------------------------------------------------------------
/// Workflows, AI activity, integrations
/// ---------------------------------------------------------------------------

/// Org-level workflow configuration. Built-in workflows are code-defined; rows
/// here enable/disable them or (later) hold user-authored workflow definitions.
model Workflow {
  id             String        @id @default(cuid())
  organizationId String?
  verticalId     String
  key            String
  name           String
  description    String?
  enabled        Boolean       @default(true)
  definition     Json          @default("{}")
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vertical       Vertical      @relation(fields: [verticalId], references: [id])

  @@unique([organizationId, key])
}

enum AIActionStatus {
  SUCCEEDED
  FAILED
}

/// One AI action taken from any surface. Powers History. Not written when the
/// user disables history.
model AIAction {
  id               String          @id @default(cuid())
  organizationId   String
  userId           String
  verticalId       String
  skillId          String
  actionId         String?
  label            String
  appId            String
  appName          String
  domain           String?
  surface          String?
  instruction      String?
  inputText        String?
  outputText       String?
  /// Labels + reasons of the context blocks used (not the full context).
  contextUsed      Json            @default("[]")
  structuredOutput Json?
  provider         String
  model            String
  status           AIActionStatus  @default(SUCCEEDED)
  error            String?
  latencyMs        Int             @default(0)
  inputTokens      Int?
  outputTokens     Int?
  /// "replace" | "insert" | "copy" once the user applied the result.
  executedAs       String?
  executedAt       DateTime?
  conversationId   String?
  createdAt        DateTime        @default(now())
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation     AIConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([organizationId, userId, createdAt])
}

/// Multi-turn interactions (e.g. refining a result: "shorter", "more formal").
model AIConversation {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  verticalId     String
  title          String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages       AIMessage[]
  actions        AIAction[]

  @@index([userId, updatedAt])
}

model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime       @default(now())
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

/// Connections to external systems (Gmail API, HubSpot, Notion…). Placeholder for MVP.
model Integration {
  id             String       @id @default(cuid())
  organizationId String
  provider       String
  status         String       @default("disconnected")
  config         Json         @default("{}")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
}
