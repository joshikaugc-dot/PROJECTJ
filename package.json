{
  "name": "contextos",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "pnpm --filter @contextos/database db:generate",
    "db:push": "pnpm --filter @contextos/database db:push",
    "db:seed": "pnpm --filter @contextos/database db:seed",
    "db:reset": "pnpm --filter @contextos/database db:reset",
    "test:e2e": "node tests/e2e/extension.e2e.mjs && node tests/e2e/web.e2e.mjs",
    "setup:local": "node scripts/setup.mjs",
    "test:e2e:extension": "node tests/e2e/extension.e2e.mjs",
    "test:e2e:web": "node tests/e2e/web.e2e.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.0",
    "jsdom": "^26.1.0",
    "playwright": "1.56.1"
  },
  "engines": {
    "node": ">=20"
  }
}
