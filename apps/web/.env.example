# Copy to apps/web/.env.local
DATABASE_URL="postgresql://contextos:contextos@localhost:5432/contextos?schema=public"

# Public URL of this app (used for extension connect + cookies)
CONTEXTOS_APP_URL="http://localhost:3000"

# AI providers — set at least one for real AI. Without keys an offline demo model answers.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Optional model overrides per tier (fast | balanced | powerful)
# ANTHROPIC_MODEL_FAST="claude-haiku-4-5"
# ANTHROPIC_MODEL_BALANCED="claude-sonnet-5-5"
# ANTHROPIC_MODEL_POWERFUL="claude-opus-5-5"
# OPENAI_MODEL_BALANCED="gpt-5"
# GEMINI_MODEL_BALANCED="gemini-2.5-pro"

# Set to "true" to fail instead of using the offline demo model when no key is configured
# CONTEXTOS_DISABLE_DEMO_MODEL="true"
